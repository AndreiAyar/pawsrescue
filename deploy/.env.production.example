# Supabase Session pooler values from Supabase -> Connect.
# Keep DATABASE_URL empty when using the separate values below.
DATABASE_URL=
DB_HOST_NEST=aws-0-REGION.pooler.supabase.com
DB_PORT_NEST=5432
DB_USER_NEST=postgres.PROJECT_REF
DB_PASSWORD_NEST=YOUR_DATABASE_PASSWORD
DB_NAME_NEST=postgres
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10

# Requests are same-origin through Nginx, so this normally stays empty.
CORS_ORIGINS=

AI_MODEL_NAME=auto
AI_OFFLINE_MODEL_LOAD=false
AI_REQUEST_TIMEOUT_MS=180000
AI_TARGET_EMBEDDING_DIM=1024
AI_CAT_DETECTION_THRESHOLD=0.65
AI_CAT_CROP_PADDING=0.08
AI_CAT_CROP_WEIGHT=0.8
