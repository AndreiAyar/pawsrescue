# Supabase Session pooler connection string, URL-encoded password, SSL required.
# Use port 5432 for Session mode. Do not commit the real value.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_MAX=10

# Requests are same-origin through Nginx, so this normally stays empty.
CORS_ORIGINS=

AI_MODEL_NAME=auto
AI_OFFLINE_MODEL_LOAD=false
AI_REQUEST_TIMEOUT_MS=180000
AI_TARGET_EMBEDDING_DIM=1024
AI_CAT_DETECTION_THRESHOLD=0.65
AI_CAT_CROP_PADDING=0.08
AI_CAT_CROP_WEIGHT=0.8
