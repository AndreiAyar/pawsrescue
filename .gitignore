# Shared rules apply at every workspace depth unless anchored with /.

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/install-state.gz

# Environment files (keep sanitized templates versioned)
.env
.env.*
!.env.example
!.env.*.example

# Turborepo and deployment caches
.turbo/
.vercel/

# Build output and TypeScript caches
.next*/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.eslintcache

# Test output
coverage/
.nyc_output/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
playwright-report/
test-results/

# Python environments and generated files
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/

# Logs and runtime files
logs/
*.log
pids/
*.pid
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
.temp/
.tmp/

# OS and local editor files
.DS_Store
Thumbs.db
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.pem

# Local AI/tooling state
.agent/
.codex/
.claude/
.gemini/
