AI_PORT=8000
AI_MODEL_NAME=auto
# Public model; no Hugging Face credentials required.
# Rebuild stored embeddings when changing the model or crop settings.
AI_TRANSFORMERS_MODEL_NAME=facebook/dinov2-small
AI_TARGET_EMBEDDING_DIM=1024
AI_CAT_DETECTION_THRESHOLD=0.65
AI_CAT_CROP_PADDING=0.08
AI_CAT_CROP_WEIGHT=0.8
# Optional override. The local launcher defaults to ../api/uploads.
# UPLOAD_DIR=/absolute/path/to/uploads

# The Python service also consumes upload jobs and saves vectors in Postgres.
# Locally, DB_* / DATABASE_URL and Redis settings default to apps/api/.env.development.local.
# Override them here when the worker runs on a different machine.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_PREFIX=pawsrescue
# Set false only for an HTTP-only AI service.
AI_WORKER_ENABLED=true
