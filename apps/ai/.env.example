AI_PORT=8000
AI_MODEL_NAME=auto
# DINOv3 requires an authorized Hugging Face account. This public model works
# without credentials. Rebuild all stored embeddings when changing models.
AI_TRANSFORMERS_MODEL_NAME=facebook/dinov2-small
AI_TARGET_EMBEDDING_DIM=1024
AI_CAT_DETECTION_THRESHOLD=0.65
AI_CAT_CROP_PADDING=0.08
AI_CAT_CROP_WEIGHT=0.8
UPLOAD_DIR=/shared-uploads
