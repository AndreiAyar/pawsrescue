PORT=3015
# Optional alternative to the separate DB_* values below.
DATABASE_URL=
DB_POOL_MAX=10
# Only needed when the API is accessed from another browser origin.
CORS_ORIGINS=http://localhost:3060

# Local PostgreSQL fallback when DATABASE_URL is unset in development.
DB_HOST_NEST=localhost
DB_PORT_NEST=5432
DB_USER_NEST=postgres
DB_PASSWORD_NEST=postgres
DB_NAME_NEST=pawsrescue
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
AI_SERVICE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=180000
USE_MOCK_DATA=false
UPLOAD_DIR=uploads

# Durable upload processing. Scan continues to call AI synchronously.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_PREFIX=pawsrescue

# Cosine-distance cutoff for similar photos; a heuristic, not identity confidence.
AI_MATCH_MAX_DISTANCE=0.5
