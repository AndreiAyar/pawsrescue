PORT=3015
# Supabase: use the Session pooler URL on IPv4-only hosts such as most Droplets.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_MAX=10
# Only needed when the API is accessed from another browser origin.
CORS_ORIGINS=http://localhost:3060

# Local PostgreSQL fallback when DATABASE_URL is unset in development.
DB_HOST_NEST=localhost
DB_PORT_NEST=5432
DB_USER_NEST=postgres
DB_PASSWORD_NEST=postgres
DB_NAME_NEST=pawsrescue
AI_SERVICE_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=180000
USE_MOCK_DATA=false
UPLOAD_DIR=uploads
