POSTGRES_DB=pawsrescue
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

API_PORT=3015
REDIS_PORT=6379
WEB_PORT=3060
AI_PORT=8000
AI_MODEL_NAME=auto
AI_TRANSFORMERS_MODEL_NAME=facebook/dinov2-small
AI_OFFLINE_MODEL_LOAD=false
AI_TARGET_EMBEDDING_DIM=1024
AI_CAT_DETECTION_THRESHOLD=0.65
AI_CAT_CROP_PADDING=0.08
AI_CAT_CROP_WEIGHT=0.8

USE_MOCK_DATA=false
UPLOAD_DIR=uploads

# Browser-visible key, embedded during the web build. Restrict allowed origins.
NEXT_PUBLIC_MAPTILER_API_KEY=

# Cosine-distance cutoff for similar photos; a heuristic, not identity confidence.
AI_MATCH_MAX_DISTANCE=0.5
