{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "API_PROXY_ENABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["API_URL", "NEXT_DIST_DIR", "NEXT_PUBLIC_MAPTILER_API_KEY"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "public/vendor/maplibre/**"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "env": ["UI_STYLES_POLL_MS"],
      "cache": false,
      "persistent": true
    }
  }
}
